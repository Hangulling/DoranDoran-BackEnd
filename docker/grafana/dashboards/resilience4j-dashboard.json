{
  "title": "Resilience4j & Auth/Login Overview",
  "uid": "res4j-auth-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_server_requests_seconds_count, application)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "CB OPEN count (last 10m)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(resilience4j_circuitbreaker_state_transitions_total{state=\"OPEN\"}[10m]))"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "gauge",
      "title": "Auth→User 실패율 (5m)",
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "percentage", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.4}, {"color": "red", "value": 0.6}]}}},
      "targets": [
        {"expr": "sum(rate(resilience4j_circuitbreaker_calls_total{kind=\"failed\", name=~\"user-service|openai\"}[5m])) / sum(rate(resilience4j_circuitbreaker_calls_total{name=~\"user-service|openai\"}[5m]))"}
      ],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "/api/auth/login p95 (5m)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/auth/login\"}[5m])))"}
      ],
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "OpenAI timeout율 (5m)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(resilience4j_timelimiter_calls_total{kind=\"timeout\"}[5m])) / sum(rate(resilience4j_timelimiter_calls_total[5m]))"}
      ],
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "timeSeries",
      "title": "CB 상태",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum by (state,name) (resilience4j_circuitbreaker_state)"}
      ],
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}
    },
    {
      "type": "timeSeries",
      "title": "Retry 재시도/성공",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum by (name) (rate(resilience4j_retry_calls_total{kind=\"retried\"}[5m]))"},
        {"expr": "sum by (name) (rate(resilience4j_retry_calls_total{kind=\"successful_with_retry\"}[5m]))"}
      ],
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}
    },
    {
      "type": "timeSeries",
      "title": "Hikari active/idle",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(hikaricp_active_connections)"},
        {"expr": "sum(hikaricp_idle_connections)"}
      ],
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}
    },
    {
      "type": "timeSeries",
      "title": "Auth /login·/me 오류율",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/auth/login\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/auth/login\"}[5m]))"},
        {"expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/auth/me\", outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/auth/me\"}[5m]))"}
      ],
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}
    }
  ]
}


